---
import "../styles/global.css";

const classes = [
  { name: "Reformer Base", level: "Todos los niveles", text: "Control, alineación y fuerza desde los fundamentos. La mejor forma de comenzar y perfeccionar tu técnica." },
  { name: "Reformer Flow", level: "Intermedio", text: "Secuencias fluidas que conectan respiración, precisión y resistencia para entrenar el cuerpo completo." },
  { name: "Reformer Athletic", level: "Intenso", text: "Un formato dinámico que combina potencia, estabilidad y cardio de bajo impacto sobre el reformer." },
  { name: "Restore & Stretch", level: "Suave", text: "Movilidad consciente, liberación de tensión y estiramientos profundos para recuperar mejor." }
];

const instagramUrl = "https://www.instagram.com/thecoresite/";
const whatsappUrl = "https://wa.link/g1usk0";
const whatsappPhone = "50763930891";
const reviewUrl = "https://g.page/r/CYwLzRQcMcMnECE/review";
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=The+Core+Site%2C+C.+D+Sur+4567%2C+David%2C+Provincia+de+Chiriqu%C3%AD";
const mapsEmbedUrl = "https://www.google.com/maps?q=The%20Core%20Site%2C%20C.%20D%20Sur%204567%2C%20David%2C%20Chiriqu%C3%AD%2C%20Panam%C3%A1&z=16&output=embed";

const socialPosts = [
  {
    image: "/instagram-posture.webp",
    width: 1080,
    height: 1350,
    href: "https://www.instagram.com/thecoresite/p/DdhgFvszVRt/",
    alt: "Guía visual de postura y alineación durante un ejercicio de Pilates"
  },
  {
    image: "/instagram-challenge.webp",
    width: 640,
    height: 1136,
    href: "https://www.instagram.com/thecoresite/reel/DdDCT9mzq01/",
    alt: "Instructora de Pilates sentada sobre una colchoneta en el estudio"
  },
  {
    image: "/instagram-connect.webp",
    width: 1200,
    height: 1600,
    href: "https://www.instagram.com/iamyai_/p/DdNWgS5gF5u/",
    alt: "Comunidad de The Core Site frente al espejo del estudio"
  },
  {
    image: "/instagram-coach.webp",
    width: 640,
    height: 1136,
    href: "https://www.instagram.com/thecoresite/reel/Dc6RYW8PEQm/",
    alt: "Coach guiando una clase de Pilates en The Core Site"
  },
  {
    image: "/instagram-coffee.webp",
    width: 900,
    height: 1125,
    href: "https://www.instagram.com/thecoresite/p/Dcygf_1IFfH/",
    alt: "Alumna entrenando brazos durante una clase de Pilates"
  },
  {
    image: "/instagram-equipment.webp",
    width: 640,
    height: 1136,
    href: "https://www.instagram.com/thecoresite/reel/Dccc4qXPxYq/",
    alt: "Equipo de Pilates preparado sobre las colchonetas de The Core Site"
  }
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#523e33" />
    <meta name="description" content="Pilates Reformer para moverte con control, fuerza y confianza." />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>The Core Site — Pilates Reformer</title>
  </head>
  <body>
    <main>
      <section class="hero" id="inicio" data-motion>
        <header class="site-header">
          <nav class="desktop-nav" aria-label="Navegación principal">
            <a href="#inicio">Inicio</a>
            <a href="#metodo">Método</a>
            <a href="#clases">Clases</a>
            <a href="#estudio">Estudio</a>
            <a href="#contacto">Contacto</a>
          </nav>
          <a class="brand" href="#inicio" aria-label="The Core Site, inicio">
            <img class="brand-logo" src="/core-logo.png" alt="" width="720" height="304" decoding="async" />
          </a>
          <a class="header-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Clase de prueba</a>
          <details class="mobile-menu">
            <summary aria-label="Abrir menú"><span></span><span></span></summary>
            <nav aria-label="Navegación móvil">
              <a href="#metodo">Método</a>
              <a href="#clases">Clases</a>
              <a href="#comunidad">Comunidad</a>
              <a href="#estudio">Estudio</a>
              <a href="#contacto">Contacto</a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Clase de prueba</a>
            </nav>
          </details>
        </header>

        <div class="hero-copy" aria-hidden="true">
          <div class="hero-copy-track">
            <div class="hero-copy-group"><span>PILATES</span><span>PILATES</span></div>
            <div class="hero-copy-group"><span>PILATES</span><span>PILATES</span></div>
          </div>
        </div>
        <img class="hero-image" src="/pilates-hero.webp" alt="Mujer practicando Pilates Reformer en un estudio contemporáneo" width="1536" height="864" fetchpriority="high" decoding="async" />
        <div class="hero-kicker"><span>Movimiento consciente</span><span>Fuerza real</span></div>
      </section>

      <section class="intro" id="metodo">
        <div class="section-label">01 — El método</div>
        <div class="intro-grid">
          <h1>REFORMA TU CUERPO.<br />REDEFINE TUS LÍMITES.</h1>
          <div class="intro-copy">
            <p>Pilates Reformer transforma la forma en que te mueves. Trabajamos fuerza, movilidad y control en cada sesión para que te sientas mejor dentro y fuera del estudio.</p>
            <a class="text-link" href="#clases">Explorar las clases</a>
          </div>
        </div>
      </section>

      <section class="experience" id="reserva">
        <div class="experience-media" aria-label="Momentos dentro de The Core Site">
          <div class="experience-image experience-image-primary">
            <img src="/instagram-connect.webp" alt="Alumna dentro del estudio de The Core Site" width="1200" height="1600" loading="lazy" decoding="async" />
          </div>
          <div class="experience-image experience-image-secondary">
            <img src="/instagram-challenge.webp" alt="Instructora de Pilates en el estudio" width="640" height="1136" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="experience-copy">
          <div class="section-label dark">Tu primera experiencia</div>
          <h2>UN ESPACIO PARA<br />VOLVER A TU CENTRO.</h2>
          <p class="experience-lead">En The Core Site entrenas con intención: atención real, movimiento preciso y una comunidad que te acompaña.</p>
          <div class="experience-values">
            <article><span aria-hidden="true"></span><div><h3>Tiempo bien invertido</h3><p>Cada sesión está pensada para que salgas más fuerte, presente y conectada contigo.</p></div></article>
            <article><span aria-hidden="true"></span><div><h3>Guía que se siente cercana</h3><p>Te acompañamos con técnica, progresiones claras y atención a tu propio ritmo.</p></div></article>
            <article><span aria-hidden="true"></span><div><h3>Movimiento con propósito</h3><p>Una práctica contemporánea que construye control, confianza y bienestar real.</p></div></article>
          </div>
          <a class="experience-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Reserva tu primera clase</a>
        </div>
      </section>

      <section class="classes" id="clases">
        <div class="section-heading">
          <div class="section-label dark">02 — Clases</div>
          <h2>ENCUENTRA<br />TU RITMO.</h2>
          <p>Formatos pensados para acompañarte desde tu primera sesión hasta tus objetivos más ambiciosos.</p>
        </div>
        <div class="class-list">
          {classes.map((item, index) => (
            <details class="class-row" open={index === 0}>
              <summary>
                <span class="class-index">0{index + 1}</span>
                <span class="class-name">{item.name}</span>
                <span class="class-level">{item.level}</span>
                <span class="class-plus" aria-hidden="true">+</span>
              </summary>
              <p>{item.text}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="community" id="comunidad">
        <div class="community-heading">
          <div class="section-label">03 — Comunidad</div>
          <p class="community-mantra">Everything starts at the CORE.</p>
          <h2>MUÉVETE.<br />CONECTA.<br />CRECE.</h2>
          <a class="text-link community-profile" href={instagramUrl} target="_blank" rel="noopener noreferrer">
            Seguir @thecoresite
          </a>
        </div>
        <div class="social-reel" aria-label="Publicaciones recientes de Instagram" data-motion>
          <div class="social-track">
            {socialPosts.map((post) => (
              <a class="social-card" href={post.href} target="_blank" rel="noopener noreferrer" aria-label={`${post.alt} — ver en Instagram`}>
                <img src={post.image} alt={post.alt} width={post.width} height={post.height} loading="eager" decoding="async" fetchpriority="low" />
                <span>Ver en Instagram</span>
              </a>
            ))}
            {socialPosts.map((post) => (
              <a class="social-card" href={post.href} target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1">
                <img src={post.image} alt="" width={post.width} height={post.height} loading="eager" decoding="async" fetchpriority="low" />
                <span>Ver en Instagram</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="studio" id="estudio">
        <div class="amenities-heading">
          <div class="section-label dark">04 — El estudio</div>
          <h2>Comodidades</h2>
          <p>Todo lo necesario para que tu práctica se sienta simple, cómoda y acompañada.</p>
        </div>
        <ul class="amenities-grid" aria-label="Comodidades y características del estudio">
          <li><span>Pilates Reformer</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 34h34M11 34V21h26v13M16 21v-7h16v7M14 38v-4M34 38v-4" /></svg></li>
          <li><span>Grupos reducidos</span><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="17" cy="18" r="5"/><circle cx="32" cy="17" r="4"/><path d="M8 36c1-7 4-11 9-11s9 4 10 11M27 25c6 0 10 4 11 11"/></svg></li>
          <li><span>Guía personalizada</span><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="15" r="6"/><path d="M11 37c2-9 6-14 13-14s11 5 13 14M35 10v10M30 15h10"/></svg></li>
          <li><span>Equipamiento premium</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 28h28M14 21v14M34 21v14M8 24v8M40 24v8M18 24v8M30 24v8"/></svg></li>
          <li><span>Mats y accesorios</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 14h23a7 7 0 0 1 0 14H17a7 7 0 0 0 0 14h21M10 14v21"/><circle cx="33" cy="21" r="7"/></svg></li>
          <li><span>Espejos de cuerpo completo</span><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="12" y="7" width="24" height="34" rx="2"/><path d="m17 32 14-14M17 22l5-5"/></svg></li>
          <li><span>Primera clase guiada</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 11h28v28H10zM17 25l5 5 10-12"/></svg></li>
          <li><span>Atención con reserva</span><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="9" y="12" width="30" height="28" rx="3"/><path d="M16 8v8M32 8v8M9 20h30M17 30l5 5 10-11"/></svg></li>
          <li><span>Reserva por WhatsApp</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M38 22a14 14 0 0 1-20 13l-8 3 3-8A14 14 0 1 1 38 22Z"/><path d="M19 16c1 7 5 11 12 13M20 17l-3 3M30 29l3-3"/></svg></li>
          <li><span>Plaza JBC · David</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M37 20c0 10-13 21-13 21S11 30 11 20a13 13 0 1 1 26 0Z"/><circle cx="24" cy="20" r="4"/></svg></li>
          <li><span>Ambiente boutique</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 7l4 11 11 4-11 4-4 11-4-11-11-4 11-4 4-11Z"/></svg></li>
          <li><span>Fácil llegada</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 36h32M12 36l3-15h18l3 15M18 21l3-8h6l3 8M18 29h12"/></svg></li>
        </ul>
      </section>

      <section class="contact" id="contacto">
        <div class="contact-heading">
          <div>
            <div class="section-label dark">05 — Contacto</div>
            <h2>GET IN<br />TOUCH.</h2>
          </div>
          <div class="contact-intro">
            <p>¿Primera vez en Pilates o ya tienes experiencia? Cuéntanos qué estás buscando y te ayudamos a elegir tu clase.</p>
            <div class="contact-channels">
              <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
              <a class="contact-channel-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
            </div>
          </div>
        </div>
        <div class="contact-grid">
          <form class="contact-form" id="contact-form" data-whatsapp-phone={whatsappPhone} action={`https://wa.me/${whatsappPhone}`} method="get" target="_blank">
            <div class="form-field">
              <label for="contact-name">Nombre</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" required />
            </div>
            <div class="form-field">
              <label for="contact-email">Email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="tu@email.com" required />
            </div>
            <div class="form-field">
              <label for="contact-phone">Teléfono</label>
              <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder="+507" />
            </div>
            <div class="form-field form-field-wide">
              <label for="contact-message">Mensaje</label>
              <textarea id="contact-message" name="message" rows="4" placeholder="Cuéntanos cómo podemos ayudarte" required></textarea>
            </div>
            <button type="submit">Enviar por WhatsApp</button>
          </form>
          <div class="location-card">
            <div class="map-shell">
              <div class="map-fallback" aria-hidden="true">
                <span class="map-pin">●</span>
                <strong>The Core Site</strong>
                <small>Plaza JBC · David</small>
              </div>
              <iframe src={mapsEmbedUrl} title="Ubicación de The Core Site en Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            </div>
            <div class="location-details">
              <div>
                <span>Visítanos</span>
                <p>Plaza JBC · C. D Sur 4567<br />David, Chiriquí, Panamá</p>
              </div>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar</a>
            </div>
          </div>
        </div>
      </section>

      <footer class="site-footer">
        <div class="footer-main">
          <div class="footer-intro">
            <a class="footer-brand" href="#inicio">
              <img class="brand-logo" src="/core-logo.png" alt="" width="720" height="304" loading="lazy" />
              <span class="sr-only">The Core Site</span>
            </a>
            <p>Pilates Studio en David, Chiriquí. Técnica, comunidad y movimiento con sentido.</p>
            <div class="footer-socials">
              <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram de The Core Site">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
              </a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Reservar por WhatsApp">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path></svg>
              </a>
            </div>
          </div>
          <nav class="footer-nav" aria-label="Enlaces de pie de página">
            <span>Explorar</span>
            <a href="#metodo">El método</a>
            <a href="#clases">Clases</a>
            <a href="#estudio">Sobre nosotros</a>
            <a href="#comunidad">Comunidad</a>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Primera clase</a>
          </nav>
          <div class="footer-studio">
            <span>Estudio</span>
            <p>Plaza JBC · David, Chiriquí</p>
            <p>Atención con reserva previa</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Reservar por WhatsApp</a>
            <a href={reviewUrl} target="_blank" rel="noopener noreferrer">Deja tu review <span aria-hidden="true">♥</span></a>
          </div>
        </div>
        <div class="footer-bottom">
          <small>© {year} The Core Site</small>
          <span>Movimiento consciente · Pilates contemporáneo</span>
        </div>
      </footer>
    </main>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const animatedSections = document.querySelectorAll("[data-motion]");

        if ("IntersectionObserver" in window) {
          const motionObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              entry.target.classList.toggle("motion-paused", !entry.isIntersecting);
            });
          }, { rootMargin: "100px" });

          animatedSections.forEach((section) => motionObserver.observe(section));
        }

        document.addEventListener("visibilitychange", () => {
          root.classList.toggle("page-hidden", document.hidden);
        });

        const contactForm = document.querySelector("#contact-form");
        contactForm?.addEventListener("submit", (event) => {
          event.preventDefault();
          const whatsappPhone = contactForm.dataset.whatsappPhone;
          const data = new FormData(contactForm);
          const name = String(data.get("name") || "").trim();
          const email = String(data.get("email") || "").trim();
          const phone = String(data.get("phone") || "").trim();
          const message = String(data.get("message") || "").trim();
          const lines = [
            `Hola 🤎 Soy ${name}.`,
            `Email: ${email}`,
            phone ? `Teléfono: ${phone}` : "",
            `Mensaje: ${message}`
          ].filter(Boolean);
          if (whatsappPhone) {
            window.open(`https://wa.me/${whatsappPhone}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank", "noopener,noreferrer");
          }
        });
      })();
    </script>
  </body>
</html>
