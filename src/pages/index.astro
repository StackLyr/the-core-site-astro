---
import "../styles/global.css";

const classes = [
  { name: "Reformer Base", level: "Todos los niveles", text: "Control, alineación y fuerza desde los fundamentos. La mejor forma de comenzar y perfeccionar tu técnica." },
  { name: "Reformer Flow", level: "Intermedio", text: "Secuencias fluidas que conectan respiración, precisión y resistencia para entrenar el cuerpo completo." },
  { name: "Reformer Athletic", level: "Intenso", text: "Un formato dinámico que combina potencia, estabilidad y cardio de bajo impacto sobre el reformer." },
  { name: "Restore & Stretch", level: "Suave", text: "Movilidad consciente, liberación de tensión y estiramientos profundos para recuperar mejor." }
];

const instagramUrl = "https://www.instagram.com/thecoresite/";
const whatsappUrl = "https://wa.link/g1usk0";
const reviewUrl = "https://g.page/r/CYwLzRQcMcMnECE/review";

const socialPosts = [
  {
    label: "Técnica",
    title: "Una buena postura cambia todo.",
    text: "Alineación, control y atención a cada detalle para moverte con intención.",
    image: "/instagram-posture.jpg",
    width: 512,
    height: 640,
    href: "https://www.instagram.com/thecoresite/p/DdhgFvszVRt/",
    alt: "Guía visual de postura y alineación durante un ejercicio de Pilates"
  },
  {
    label: "Reto",
    title: "Elige tu desafío.",
    text: "Progresiones que respetan tu nivel y te invitan a descubrir de qué eres capaz.",
    image: "/instagram-challenge.jpg",
    width: 360,
    height: 640,
    href: "https://www.instagram.com/thecoresite/reel/DdDCT9mzq01/",
    alt: "Instructora de Pilates sentada sobre una colchoneta en el estudio"
  },
  {
    label: "Detalle",
    title: "Todo está en los detalles.",
    text: "Acompañamiento cercano para construir fuerza, confianza y una práctica que se sienta tuya.",
    image: "/instagram-details.jpg",
    width: 360,
    height: 640,
    href: "https://www.instagram.com/thecoresite/reel/DcokgTaPJe7/",
    alt: "Mujer entrenando brazos frente al espejo de un estudio de Pilates"
  }
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#523e33" />
    <meta name="description" content="Pilates Reformer para moverte con control, fuerza y confianza." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>The Core Site — Pilates Reformer</title>
  </head>
  <body>
    <main>
      <section class="hero" id="inicio">
        <header class="site-header">
          <nav class="desktop-nav" aria-label="Navegación principal">
            <a href="#inicio">Inicio</a>
            <a href="#metodo">Método</a>
            <a href="#clases">Clases</a>
            <a href="#estudio">Estudio</a>
          </nav>
          <a class="brand" href="#inicio" aria-label="The Core Site, inicio">
            <img class="brand-logo" src="/core-logo.png" alt="" width="720" height="304" />
          </a>
          <a class="header-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Clase de prueba</a>
          <details class="mobile-menu">
            <summary aria-label="Abrir menú"><span></span><span></span></summary>
            <nav aria-label="Navegación móvil">
              <a href="#metodo">Método</a>
              <a href="#clases">Clases</a>
              <a href="#comunidad">Comunidad</a>
              <a href="#estudio">Estudio</a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Clase de prueba</a>
            </nav>
          </details>
        </header>

        <div class="hero-copy" aria-hidden="true">
          <div class="hero-copy-track">
            <div class="hero-copy-group"><span>PILATES</span><span>PILATES</span></div>
            <div class="hero-copy-group"><span>PILATES</span><span>PILATES</span></div>
          </div>
        </div>
        <img class="hero-image" src="/pilates-hero.webp" alt="Mujer practicando Pilates Reformer en un estudio contemporáneo" width="1536" height="864" fetchpriority="high" />
        <div class="hero-kicker"><span>Movimiento consciente</span><span>Fuerza real</span></div>
        <a class="scroll-cue" href="#metodo" aria-label="Descubrir el método">↓</a>
      </section>

      <section class="intro" id="metodo">
        <div class="section-label">01 — El método</div>
        <div class="intro-grid">
          <h1>REFORMA TU CUERPO.<br />REDEFINE TUS LÍMITES.</h1>
          <div class="intro-copy">
            <p>Pilates Reformer transforma la forma en que te mueves. Trabajamos fuerza, movilidad y control en cada sesión para que te sientas mejor dentro y fuera del estudio.</p>
            <a class="text-link" href="#clases">Explorar las clases <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="trial" id="reserva">
        <div class="trial-number" aria-hidden="true">01</div>
        <div class="trial-content">
          <p>Tu primera experiencia</p>
          <h2>PRIMERA<br />CLASE</h2>
          <span>Una sesión para conocer el reformer, tu nivel y la forma de entrenar que mejor encaja contigo.</span>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Reservar clase <span aria-hidden="true">↗</span></a>
        </div>
        <div class="trial-seal" aria-hidden="true">MUÉVETE · RESPIRA · AVANZA ·</div>
      </section>

      <section class="classes" id="clases">
        <div class="section-heading">
          <div class="section-label dark">02 — Clases</div>
          <h2>ENCUENTRA<br />TU RITMO.</h2>
          <p>Formatos pensados para acompañarte desde tu primera sesión hasta tus objetivos más ambiciosos.</p>
        </div>
        <div class="class-list">
          {classes.map((item, index) => (
            <details class="class-row" open={index === 0}>
              <summary>
                <span class="class-index">0{index + 1}</span>
                <span class="class-name">{item.name}</span>
                <span class="class-level">{item.level}</span>
                <span class="class-plus" aria-hidden="true">+</span>
              </summary>
              <p>{item.text}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="community" id="comunidad">
        <div class="community-heading">
          <div class="section-label">03 — Comunidad</div>
          <p class="community-mantra">Everything starts at the CORE.</p>
          <h2>MUÉVETE.<br />CONECTA.<br />CRECE.</h2>
          <a class="text-link community-profile" href={instagramUrl} target="_blank" rel="noopener noreferrer">
            Seguir @thecoresite <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="social-grid">
          {socialPosts.map((post, index) => (
            <a class="social-card" href={post.href} target="_blank" rel="noopener noreferrer" aria-label={`${post.label}: ${post.title} — ver en Instagram`}>
              <div class="social-media">
                <img src={post.image} alt={post.alt} width={post.width} height={post.height} loading="lazy" decoding="async" />
                <span class="social-number">0{index + 1}</span>
              </div>
              <div class="social-copy">
                <span>{post.label}</span>
                <h3>{post.title}</h3>
                <p>{post.text}</p>
                <strong>Ver publicación ↗</strong>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="studio" id="estudio">
        <div class="studio-visual">
          <div class="studio-word" aria-hidden="true">CORE</div>
          <div class="studio-mark">
            <img class="brand-logo" src="/core-logo.png" alt="The Core Site" width="720" height="304" loading="lazy" />
          </div>
        </div>
        <div class="studio-copy">
          <div class="section-label">04 — El estudio</div>
          <h2>ESPACIO PARA<br />MOVERTE MEJOR.</h2>
          <p>Un estudio boutique, atención cercana y grupos reducidos. Cada detalle está pensado para que entrenes con confianza, precisión y energía.</p>
          <div class="studio-points"><span>Grupos reducidos</span><span>Guía personalizada</span><span>Equipamiento premium</span><span>David, Chiriquí</span></div>
        </div>
      </section>

      <section class="closing" id="contacto">
        <p>Empieza donde estás.</p>
        <h2>TU MOVIMIENTO<br />EMPIEZA AQUÍ.</h2>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Quiero probar una clase <span aria-hidden="true">↗</span></a>
      </section>

      <footer class="site-footer">
        <div class="footer-main">
          <a class="footer-brand" href="#inicio">
            <img class="brand-logo" src="/core-logo.png" alt="" width="720" height="304" loading="lazy" />
            <span class="sr-only">The Core Site</span>
          </a>
          <div class="footer-message">
            <p>Fuerza desde<br />el centro.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Reservar una clase <span aria-hidden="true">↗</span></a>
          </div>
          <nav class="footer-nav" aria-label="Enlaces de pie de página">
            <span>Explorar</span>
            <a href="#metodo">Método</a>
            <a href="#clases">Clases</a>
            <a href="#comunidad">Comunidad</a>
            <a href="#estudio">Estudio</a>
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
            <a href={reviewUrl} target="_blank" rel="noopener noreferrer">Dejar una reseña ↗</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <small>© {year} The Core Site</small>
          <span>Pilates Reformer · David, Chiriquí</span>
          <a href="#inicio">Volver arriba ↑</a>
        </div>
      </footer>
    </main>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const hero = document.querySelector(".hero");
        let scrollTimer;
        let scrollFrame = 0;

        const pauseDuringScroll = () => {
          if (!scrollFrame) {
            scrollFrame = requestAnimationFrame(() => {
              root.classList.add("is-scrolling");
              scrollFrame = 0;
            });
          }
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => root.classList.remove("is-scrolling"), 140);
        };

        window.addEventListener("scroll", pauseDuringScroll, { passive: true });

        if (hero && "IntersectionObserver" in window) {
          new IntersectionObserver(([entry]) => {
            root.classList.toggle("hero-outside-view", !entry.isIntersecting);
          }).observe(hero);
        }

        document.addEventListener("visibilitychange", () => {
          root.classList.toggle("page-hidden", document.hidden);
        });
      })();
    </script>
  </body>
</html>
