{
  "name": "the-core-site-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:ci": "npm ci --include=dev --no-audit --no-fund",
    "dev": "astro dev",
    "test": "node --test",
    "build": "astro build",
    "preview": "astro preview",
    "booking:dev": "npm run build && wrangler pages dev dist",
    "booking:db:init": "wrangler d1 execute core-booking --local --file=./db/schema.sql",
    "booking:db:upgrade": "wrangler d1 execute core-booking --local --file=./db/migrations/0002_memberships_email.sql",
    "booking:db:security": "wrangler d1 execute core-booking --local --file=./db/migrations/0003_admin_security.sql"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.139.0"
  }
}
